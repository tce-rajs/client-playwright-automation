# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed.

BASE_URL=https://ce-qa-school.devstudi.com/teach/

# --- Login credentials (QA account, Goyal Brothers School) ---
VALID_PIN=<5-digit PIN for the QA teacher account>
VALID_PIN_2=<5-digit PIN for a SECOND, separate QA teacher account -- used to run some suites in parallel without colliding on shared account state>
INVALID_PIN=<any 5-digit PIN that is NOT valid, used by negative tests>
SCHOOL_NAME=<school name as shown in the Sign In school dropdown>
SCHOOL_SEARCH_TERM=<a substring of the school name, used to search the dropdown>
USERNAME=<username for password login>
PASSWORD=<password for password login>
